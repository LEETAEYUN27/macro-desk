# 백엔드 API (Render 등)
API_BASE_URL=http://localhost:8000
# 서비스 도메인 (canonical·sitemap·OG 에 사용) - 반드시 구입한 도메인으로 교체
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=글로벌 경제 관제실

# 검색엔진 소유 확인 (content 값만 입력)
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# 구글 애드센스 (승인 후 입력. 비워두면 광고 코드·구좌가 아예 렌더되지 않음)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_AD_SLOT_TOP=
NEXT_PUBLIC_AD_SLOT_SIDE=
NEXT_PUBLIC_AD_SLOT_INARTICLE=
# 개발 중 광고 위치를 점선 상자로 미리 보기 (운영에서는 0)
NEXT_PUBLIC_SHOW_AD_PLACEHOLDER=1

# 문의 이메일 (애드센스 심사용 연락처 페이지)
NEXT_PUBLIC_CONTACT_EMAIL=
# 정적 빌드 여부
STATIC_EXPORT=0

# Cloudflare Web Analytics 토큰 (무료 방문자 통계)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
